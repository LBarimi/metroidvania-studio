static func parse(value: String) -> int:
    var source := value.strip_edges()
    if source.is_empty() or source.to_lower() == "none": return Id.None
    if source.to_lower().begins_with("trigger"):
        source = source.substr(7)
        if source.length() != 3: return Id.None
    if source.is_empty(): return Id.None
    for character in source:
        if character < "0" or character > "9": return Id.None
    var number := source.to_int()
    return number if number >= 0 and number <= 200 else Id.None
