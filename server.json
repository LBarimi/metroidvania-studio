{
  "$schema": "https://static.modelcontextprotocol.io/schemas/2025-12-11/server.schema.json",
  "name": "io.github.LBarimi/metroidvania-studio",
  "title": "Metroidvania Studio",
  "description": "Create and edit connected 2D maps with a local, workspace-scoped MCP server and Lua scripts.",
  "repository": { "url": "https://github.com/LBarimi/metroidvania-studio", "source": "github" },
  "version": "1.1.0",
  "packages": [
    {
      "registryType": "npm",
      "identifier": "metroidvania-studio",
      "version": "1.1.0",
      "runtimeHint": "npx",
      "transport": { "type": "stdio" },
      "packageArguments": [
        { "type": "positional", "value": "mcp" },
        {
          "type": "named", "name": "--workspace", "value": "{workspace}",
          "variables": {
            "workspace": { "description": "Local folder containing the maps and scripts this server may access.", "isRequired": true, "format": "string" }
          }
        }
      ]
    }
  ]
}
