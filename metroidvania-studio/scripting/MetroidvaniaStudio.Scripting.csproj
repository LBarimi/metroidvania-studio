<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <RestorePackagesWithLockFile>true</RestorePackagesWithLockFile>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="../automation/MetroidvaniaStudio.Automation.csproj" />
    <Reference Include="MoonSharp.Interpreter">
      <HintPath>../../.local/scripting-runtime/lib/MoonSharp.Interpreter.dll</HintPath>
      <Private>true</Private>
    </Reference>
    <Content Include="licenses/*" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
  </ItemGroup>
  <Target Name="EnsureLuaRuntime" BeforeTargets="ResolveAssemblyReferences" Condition="!Exists('../../.local/scripting-runtime/lib/MoonSharp.Interpreter.dll')">
    <Error Text="Build the Lua runtime first: node tools/scripting/build-runtime.mjs" />
  </Target>
</Project>
