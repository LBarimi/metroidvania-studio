{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Map document version 2",
  "$comment": "Generated from Core data fields. Identity uniqueness, references, containment and aggregate limits are validated by MapDocumentStore.",
  "$ref": "#/$defs/MapDocument",
  "$defs": {
    "MapCell": {
      "type": "object",
      "properties": {
        "groupId": {
          "type": "string"
        },
        "material": {
          "type": "string"
        },
        "shape": {
          "type": "integer",
          "enum": [
            0,
            1,
            2,
            3,
            4
          ]
        },
        "x": {
          "type": "integer",
          "minimum": 0,
          "maximum": 2147483647
        },
        "y": {
          "type": "integer",
          "minimum": 0,
          "maximum": 2147483647
        }
      },
      "additionalProperties": false
    },
    "MapDocument": {
      "type": "object",
      "properties": {
        "formatVersion": {
          "type": "integer",
          "minimum": -2147483648,
          "maximum": 2147483647,
          "const": 2
        },
        "layerGroups": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/MapLayerGroup"
          },
          "maxItems": 4096
        },
        "name": {
          "type": "string"
        },
        "properties": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/MapProperty"
          }
        },
        "rooms": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/MapRoom"
          },
          "maxItems": 1024
        },
        "stylegrounds": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/MapStyleground"
          }
        },
        "tileSize": {
          "type": "integer",
          "minimum": -2147483648,
          "maximum": 2147483647,
          "const": 16
        }
      },
      "additionalProperties": false,
      "required": [
        "formatVersion",
        "tileSize",
        "rooms",
        "layerGroups"
      ]
    },
    "MapLayerGroup": {
      "type": "object",
      "properties": {
        "id": {
          "type": "string"
        },
        "layer": {
          "type": "integer",
          "enum": [
            0,
            1,
            2,
            3,
            4,
            5
          ]
        },
        "locked": {
          "type": "boolean"
        },
        "name": {
          "type": "string"
        },
        "parentId": {
          "type": "string"
        },
        "visible": {
          "type": "boolean"
        }
      },
      "additionalProperties": false,
      "required": [
        "id"
      ]
    },
    "MapObject": {
      "type": "object",
      "properties": {
        "definition": {
          "type": "string"
        },
        "groupId": {
          "type": "string"
        },
        "height": {
          "type": "number",
          "minimum": -3.4028235E+38,
          "maximum": 3.4028235E+38,
          "exclusiveMinimum": 0
        },
        "id": {
          "type": "string"
        },
        "layer": {
          "type": "integer",
          "enum": [
            2,
            3,
            4,
            5
          ]
        },
        "nodes": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/Vector2"
          },
          "maxItems": 4096
        },
        "properties": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/MapProperty"
          }
        },
        "rotation": {
          "type": "number",
          "minimum": -3.4028235E+38,
          "maximum": 3.4028235E+38
        },
        "scaleX": {
          "type": "number",
          "minimum": -3.4028235E+38,
          "maximum": 3.4028235E+38
        },
        "scaleY": {
          "type": "number",
          "minimum": -3.4028235E+38,
          "maximum": 3.4028235E+38
        },
        "width": {
          "type": "number",
          "minimum": -3.4028235E+38,
          "maximum": 3.4028235E+38,
          "exclusiveMinimum": 0
        },
        "x": {
          "type": "number",
          "minimum": -3.4028235E+38,
          "maximum": 3.4028235E+38
        },
        "y": {
          "type": "number",
          "minimum": -3.4028235E+38,
          "maximum": 3.4028235E+38
        }
      },
      "additionalProperties": false,
      "required": [
        "id"
      ]
    },
    "MapProperty": {
      "type": "object",
      "properties": {
        "key": {
          "type": "string"
        },
        "value": {
          "type": "string"
        }
      },
      "additionalProperties": false
    },
    "MapRoom": {
      "type": "object",
      "properties": {
        "background": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/MapCell"
          }
        },
        "foreground": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/MapCell"
          }
        },
        "height": {
          "type": "integer",
          "minimum": 1,
          "maximum": 1024
        },
        "id": {
          "type": "string"
        },
        "locked": {
          "type": "boolean"
        },
        "name": {
          "type": "string"
        },
        "objects": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/MapObject"
          },
          "maxItems": 16384
        },
        "properties": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/MapProperty"
          }
        },
        "visible": {
          "type": "boolean"
        },
        "width": {
          "type": "integer",
          "minimum": 1,
          "maximum": 1024
        },
        "x": {
          "type": "integer",
          "minimum": -2147483648,
          "maximum": 2147483647
        },
        "y": {
          "type": "integer",
          "minimum": -2147483648,
          "maximum": 2147483647
        }
      },
      "additionalProperties": false,
      "required": [
        "id"
      ]
    },
    "MapStyleground": {
      "type": "object",
      "properties": {
        "color": {
          "type": "string"
        },
        "id": {
          "type": "string"
        },
        "layer": {
          "type": "integer",
          "enum": [
            4,
            5
          ]
        },
        "name": {
          "type": "string"
        },
        "properties": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/MapProperty"
          }
        },
        "scrollX": {
          "type": "number",
          "minimum": -3.4028235E+38,
          "maximum": 3.4028235E+38
        },
        "scrollY": {
          "type": "number",
          "minimum": -3.4028235E+38,
          "maximum": 3.4028235E+38
        },
        "texture": {
          "type": "string"
        },
        "type": {
          "type": "string"
        }
      },
      "additionalProperties": false,
      "required": [
        "id"
      ]
    },
    "Vector2": {
      "type": "object",
      "properties": {
        "x": {
          "type": "number",
          "minimum": -3.4028235E+38,
          "maximum": 3.4028235E+38
        },
        "y": {
          "type": "number",
          "minimum": -3.4028235E+38,
          "maximum": 3.4028235E+38
        }
      },
      "additionalProperties": false
    }
  }
}
