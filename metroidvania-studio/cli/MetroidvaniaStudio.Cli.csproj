<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType><TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings><Nullable>enable</Nullable>
    <Version>$([System.Text.RegularExpressions.Regex]::Match($([System.IO.File]::ReadAllText('$(MSBuildThisFileDirectory)../../version.json')), '[0-9]+\.[0-9]+\.[0-9]+').Value)</Version>
    <AssemblyName>MetroidvaniaStudio.Cli</AssemblyName><RootNamespace>MetroidvaniaStudio.Cli</RootNamespace>
    <NuGetAudit>false</NuGetAudit><RestorePackagesWithLockFile>true</RestorePackagesWithLockFile>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="../automation/MetroidvaniaStudio.Automation.csproj" />
    <ProjectReference Include="../scripting/MetroidvaniaStudio.Scripting.csproj" />
    <PackageReference Include="ModelContextProtocol.Core" Version="[2.2.0]" />
  </ItemGroup>
  <ItemGroup><Content Include="licenses/*" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" /></ItemGroup>
</Project>
